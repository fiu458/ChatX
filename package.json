{
  "name": "chatx",
  "version": "2.0.0",
  "description": "ChatX Discord-like Electron chat with Railway backend",
  "author": "ChatX",
  "main": "client/electron/main.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:desktop": "electron .",
    "start": "electron .",
    "build:installer": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis",
    "build:unpacked": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chatx.desktop",
    "productName": "ChatX",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "client/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ChatX"
    }
  }
}